{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(cargo fmt)",
      "Bash(cargo fmt *)",
      "Bash(cargo check *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(uvx ruff@0.17.5 check *)",
      "Bash(uv run --group test pytest)",
      "Bash(uv run --group test pytest *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
